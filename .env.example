# ARGUS Cyber Deception System - Environment Configuration Template
# Duplicate this file to .env and configure strong secrets before deployment.

# Environment Mode: development | production | testing
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application Secrets (Must be changed in production)
SECRET_KEY=change_this_to_a_cryptographically_secure_random_string_32_bytes_min
ARGUS_PASSWORD_FINGERPRINT_SECRET=change_this_to_a_secure_hmac_secret_for_password_fingerprinting

# Ingestion Token for mutual Decoy-to-Backend authentication
INTERNAL_INGESTION_TOKEN=argus_internal_decoy_token_secret_replace_in_prod

# Database Configuration (PostgreSQL)
POSTGRES_USER=argus_user
POSTGRES_PASSWORD=argus_secure_password
POSTGRES_DB=argus_telemetry
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://argus_user:argus_secure_password@localhost:5432/argus_telemetry

# SQLite Fallback (Optional for standalone testing without Docker)
# DATABASE_URL=sqlite+aiosqlite:///./data/argus_telemetry.db

# File Quarantine Settings
QUARANTINE_STORAGE_DIR=./data/quarantine
MAX_UPLOAD_SIZE_BYTES=10485760 # 10 MB limit
ALLOWED_UPLOAD_EXTENSIONS=.log,.txt,.dmp,.bin,.tar,.gz,.zip,.png,.pdf,.conf

# Security & CORS Settings
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Initial Administrator Seed Credentials
ADMIN_USERNAME=argus_admin
ADMIN_EMAIL=admin@argus-defense.local
ADMIN_PASSWORD=ArgusAdmin2026!ChangeMe
